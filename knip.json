  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{ts,mjs}", "*.ts"],
  "ignore": ["src/web/routeTree.gen.ts"],
  "ignoreDependencies": ["@swc/core"],
  "ignoreBinaries": ["gitleaks"]
}
