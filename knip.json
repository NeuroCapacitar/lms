{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.ts",
    "scripts/*.mjs",
    "scripts/db/*.ts",
    "scripts/**/*.test.ts",
    "scripts/db/*.integration.ts"
