{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.ts",
    "scripts/*.mjs",
    "scripts/db/*.ts",
    "scripts/**/*.test.ts",
    "scripts/db/*.integration.ts",
    "test/**/*.test.ts",
    "e2e/**/*.spec.ts",
    "e2e-journey/*.ts",
    "playwright.journey.config.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{ts,mjs}",
    "*.ts",
    "test/**/*.ts",
    "e2e/**/*.ts",
    "e2e-journey/**/*.ts"
  ],
  "ignore": ["src/web/routeTree.gen.ts"],
  "ignoreDependencies": ["@swc/core", "cloudflare", "tailwindcss"],
  "ignoreBinaries": ["gitleaks"]
}
