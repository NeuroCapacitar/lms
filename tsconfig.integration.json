{
  "compilerOptions": {
    "target": "ES2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/server/**/*.ts",
    "src/db/**/*.ts",
    "src/features/**/*.ts",
    "worker-configuration.d.ts",
    "scripts/environments.ts",
    "test/helpers/auth.ts",
    "test/helpers/pg-schema.ts",
    "test/pg/auth.pg.test.ts",
    "test/pg/link.pg.test.ts",
    "test/pg/profile.pg.test.ts",
    "test/pg/access.pg.test.ts",
    "test/pg/reauth.pg.test.ts",
    "scripts/admin-bootstrap.ts",
    "scripts/seed-demo.ts",
    "scripts/verify-email-templates.ts",
    "scripts/seed-demo-core.ts",
    "test/helpers/demo-course.ts",
    "test/pg/demo-seed.pg.test.ts",
    "test/pg/student-catalog.pg.test.ts",
    "test/pg/public-course.pg.test.ts",
    "test/pg/entitlement.pg.test.ts",
    "test/pg/free-enrollment.pg.test.ts",
    "test/pg/learning.pg.test.ts",
    "test/pg/completion.pg.test.ts",
    "test/pg/manual-enrollment.pg.test.ts",
    "test/pg/preview.pg.test.ts",
    "e2e-journey/server.ts",
    "scripts/db/guards.ts",
    "test/pg/staff-invitation.pg.test.ts",
    "test/pg/bootstrap.pg.test.ts",
    "test/pg/suspension.pg.test.ts",
    "test/pg/methods.pg.test.ts",
    "test/pg/legal.pg.test.ts",
    "test/pg/team.pg.test.ts",
    "test/pg/catalog.pg.test.ts",
    "test/pg/curriculum.pg.test.ts",
    "test/pg/rich-text.pg.test.ts",
    "test/pg/outbox.pg.test.ts",
    "test/pg/consumer.pg.test.ts",
    "test/pg/cron.pg.test.ts",
    "test/pg/fault-matrix.pg.test.ts",
    "test/pg/email.pg.test.ts",
    "test/helpers/async-harness.ts"
  ]
}
