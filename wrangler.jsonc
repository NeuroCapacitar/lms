{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hub",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "vars": {
    "APP_BASE_URL": "http://localhost:5173",
    "EMAIL_FROM": "NeuroCapacitar <acesso@neurocapacitar.com.br>",
    "RESEND_TEMPLATE_MAGIC_LINK": "bcbd5da9-a043-4014-aba9-8b27c8e55f9d",
    "RESEND_TEMPLATE_REAUTH_LINK": "1b066eb8-2a71-4e41-94b7-15475b1e3d4d",
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "cda50f48086646dda22bbb4424791e58" }],
  "env": {
    "staging": {
      "name": "hub-staging",
      "vars": {
        "APP_BASE_URL": "https://hub-staging.neurocapacitar-projetos.workers.dev",
        "EMAIL_FROM": "NeuroCapacitar <acesso@neurocapacitar.com.br>",
        "RESEND_TEMPLATE_MAGIC_LINK": "bcbd5da9-a043-4014-aba9-8b27c8e55f9d",
        "RESEND_TEMPLATE_REAUTH_LINK": "1b066eb8-2a71-4e41-94b7-15475b1e3d4d",
      },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "cea4be9d4370457b93f1feb7469d2ceb" }],
    },
    "production": {
      "name": "hub-production",
      "vars": {
        "APP_BASE_URL": "https://hub-production.neurocapacitar-projetos.workers.dev",
        "EMAIL_FROM": "NeuroCapacitar <acesso@neurocapacitar.com.br>",
        "RESEND_TEMPLATE_MAGIC_LINK": "bcbd5da9-a043-4014-aba9-8b27c8e55f9d",
        "RESEND_TEMPLATE_REAUTH_LINK": "1b066eb8-2a71-4e41-94b7-15475b1e3d4d",
      },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "f31b83e0d8044d00a9651c81d121bc91" }],
    },
  },
}
