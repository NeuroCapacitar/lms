{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hub",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "vars": {
    "APP_BASE_URL": "http://localhost:5173",
    "EMAIL_FROM": "NeuroCapacitar <acesso@neurocapacitar.com.br>",
    "RESEND_TEMPLATE_MAGIC_LINK": "bcbd5da9-a043-4014-aba9-8b27c8e55f9d",
    "RESEND_TEMPLATE_REAUTH_LINK": "1b066eb8-2a71-4e41-94b7-15475b1e3d4d",
    "RESEND_TEMPLATE_STAFF_INVITATION": "63dee257-f261-4c40-b4f2-550596c5efcd",
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/cursos/*"],
  },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "cda50f48086646dda22bbb4424791e58" }],
  "queues": {
    "producers": [
      { "binding": "QUEUE_FINANCE", "queue": "hub-finance" },
      { "binding": "QUEUE_GENERAL", "queue": "hub-general" },
      { "binding": "DLQ_FINANCE", "queue": "hub-finance-dlq" },
      { "binding": "DLQ_GENERAL", "queue": "hub-general-dlq" },
    ],
    "consumers": [
      {
        "queue": "hub-finance",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 6,
        "max_concurrency": 2,
        "dead_letter_queue": "hub-finance-dlq",
      },
      {
        "queue": "hub-general",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 6,
        "max_concurrency": 2,
        "dead_letter_queue": "hub-general-dlq",
      },
      {
        "queue": "hub-finance-dlq",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 1,
      },
      {
        "queue": "hub-general-dlq",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 1,
      },
    ],
  },
  "env": {
    "staging": {
      "name": "hub-staging",
      "vars": {
        "APP_BASE_URL": "https://hub-staging.neurocapacitar-projetos.workers.dev",
        "EMAIL_FROM": "NeuroCapacitar <acesso@neurocapacitar.com.br>",
        "RESEND_TEMPLATE_MAGIC_LINK": "bcbd5da9-a043-4014-aba9-8b27c8e55f9d",
        "RESEND_TEMPLATE_REAUTH_LINK": "1b066eb8-2a71-4e41-94b7-15475b1e3d4d",
        "RESEND_TEMPLATE_STAFF_INVITATION": "63dee257-f261-4c40-b4f2-550596c5efcd",
      },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "cea4be9d4370457b93f1feb7469d2ceb" }],
      "queues": {
        "producers": [
          { "binding": "QUEUE_FINANCE", "queue": "hub-staging-finance" },
          { "binding": "QUEUE_GENERAL", "queue": "hub-staging-general" },
          { "binding": "DLQ_FINANCE", "queue": "hub-staging-finance-dlq" },
          { "binding": "DLQ_GENERAL", "queue": "hub-staging-general-dlq" },
        ],
        "consumers": [
          {
            "queue": "hub-staging-finance",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 6,
            "max_concurrency": 2,
            "dead_letter_queue": "hub-staging-finance-dlq",
          },
          {
            "queue": "hub-staging-general",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 6,
            "max_concurrency": 2,
            "dead_letter_queue": "hub-staging-general-dlq",
          },
          {
            "queue": "hub-staging-finance-dlq",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "max_concurrency": 1,
          },
          {
            "queue": "hub-staging-general-dlq",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "max_concurrency": 1,
          },
        ],
      },
    },
    "production": {
      "name": "hub-production",
      "vars": {
        "APP_BASE_URL": "https://hub-production.neurocapacitar-projetos.workers.dev",
        "EMAIL_FROM": "NeuroCapacitar <acesso@neurocapacitar.com.br>",
        "RESEND_TEMPLATE_MAGIC_LINK": "bcbd5da9-a043-4014-aba9-8b27c8e55f9d",
        "RESEND_TEMPLATE_REAUTH_LINK": "1b066eb8-2a71-4e41-94b7-15475b1e3d4d",
        "RESEND_TEMPLATE_STAFF_INVITATION": "63dee257-f261-4c40-b4f2-550596c5efcd",
      },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "f31b83e0d8044d00a9651c81d121bc91" }],
      "queues": {
        "producers": [
          { "binding": "QUEUE_FINANCE", "queue": "hub-production-finance" },
          { "binding": "QUEUE_GENERAL", "queue": "hub-production-general" },
          { "binding": "DLQ_FINANCE", "queue": "hub-production-finance-dlq" },
          { "binding": "DLQ_GENERAL", "queue": "hub-production-general-dlq" },
        ],
        "consumers": [
          {
            "queue": "hub-production-finance",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 6,
            "max_concurrency": 2,
            "dead_letter_queue": "hub-production-finance-dlq",
          },
          {
            "queue": "hub-production-general",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 6,
            "max_concurrency": 2,
            "dead_letter_queue": "hub-production-general-dlq",
          },
          {
            "queue": "hub-production-finance-dlq",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "max_concurrency": 1,
          },
          {
            "queue": "hub-production-general-dlq",
            "max_batch_size": 5,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "max_concurrency": 1,
          },
        ],
      },
    },
  },
}
