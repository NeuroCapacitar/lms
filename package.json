{
  "name": "hub",
  "version": "0.0.0",
  "private": true,
  "description": "NeuroCapacitar Hub vNext (LMS). Fundação em construção; ver docs/tasks/M0-fundacao.md.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:staging": "bun scripts/build-env.ts staging",
    "build:production": "bun scripts/build-env.ts production",
    "preflight": "bun scripts/preflight.ts",
    "deploy:staging": "bun scripts/deploy-staging.ts",
    "smoke": "bun scripts/smoke.ts",
    "dns:parity": "bun scripts/dns-parity.ts",
    "preview": "vite preview",
    "types": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types",
    "types:check": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --check",
    "test": "bun run build && vitest run",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.integration.json && tsc -p tsconfig.e2e.json",
    "lint": "oxlint --deny-warnings",
    "format:check": "oxfmt --check",
    "verify:quick": "bun run typecheck && bun run lint && bun run format:check",
    "db:generate": "drizzle-kit generate",
    "db:drift": "bun scripts/db/check-drift.ts",
    "db:migrate": "bun scripts/db/migrate.ts",
    "db:roles": "bun scripts/db/setup-roles.ts",
    "admin:bootstrap": "bun scripts/admin-bootstrap.ts",
    "seed:demo": "bun scripts/seed-demo.ts",
    "email:verify-templates": "bun scripts/verify-email-templates.ts",
    "test:db": "node --test \"scripts/**/*.integration.ts\"",
    "knip": "knip",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "agents:check": "node scripts/check-agent-instructions.mjs",
    "secrets": "bun scripts/secrets-scan.ts",
    "verify": "bun run verify:quick && bun run types:check && bun run db:drift && bun run test && bun run test:e2e && bun run test:journey && bun run build:staging && bun run build:production && bun run knip && bun run arch && bun run agents:check && bun run secrets",
    "test:unit": "vitest run --project unit",
    "test:workers": "bun run build && vitest run --project workers",
    "test:pg": "vitest run --project pg",
    "test:journey": "playwright test -c playwright.journey.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/lexend-deca": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@phosphor-icons/react": "2.1.10",
    "@sentry/cloudflare": "11.6.0",
    "@sentry/hono": "11.6.0",
    "@sentry/react": "11.6.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "evlog": "2.30.1",
    "hono": "4.13.13",
    "pg": "8.16.3",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "tailwind-merge": "3.7.0",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "7.4.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@playwright/test": "1.64.0",
    "@swc/core": "1.16.13",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.42",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dependency-cruiser": "18.5.0",
    "drizzle-kit": "0.31.11",
    "knip": "6.41.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "pdfjs-dist": "6.4.299",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "workbox-build": "7.4.1",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.4.2"
}
