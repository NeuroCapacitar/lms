# Copie para `.env` (ignorado pelo Git). Só NOMES e instruções; nunca valores reais aqui.
#
# Conexão LOCAL que emula o Hyperdrive no `bun run dev` / `bun run preview`.
# Valor: URL da role de RUNTIME (`hub_runtime`) do banco de DESENVOLVIMENTO (projeto Neon `hub-development`).
# Nunca use a URL de Staging ou de Production aqui.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# Banco de TESTE (Postgres 18 que pode ser destruído): projeto Neon `hub-test` no desenvolvimento local
# (guarde em `.env.test`, ignorado pelo Git) ou o serviço postgres:18 do CI. Nunca o banco de dev/staging/prod:
# os testes recusam o host desses ambientes.
TEST_DATABASE_URL=

# Segredo do Better Auth em Development (valor aleatório de 32+ bytes, só local). Em Staging e Production
# é Worker Secret por ambiente (`wrangler secret put BETTER_AUTH_SECRET --name <worker> --profile neurocapacitar`).
BETTER_AUTH_SECRET=
