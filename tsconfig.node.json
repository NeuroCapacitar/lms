{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "vite.config.ts",
    "drizzle.config.ts",
    "vitest.config.ts",
    "test/helpers/color.ts",
    "test/helpers/pg-schema.ts",
    "test/unit/**/*.ts",
    "test/pg/schema.pg.test.ts",
    "test/pg/race.pg.test.ts"
  ],
  "exclude": [
    "scripts/admin-bootstrap.ts",
    "scripts/seed-demo.ts",
    "scripts/gate-account.ts",
    "scripts/privacy/privacy-request.ts",
    "scripts/verify-email-templates.ts"
  ]
}
