{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "vite.config.ts",
    "drizzle.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "test/helpers/**/*.ts",
    "test/pg/**/*.ts",
    "e2e/**/*.ts"
  ]
}
